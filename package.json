{
  "name": "traceflow",
  "version": "0.0.0",
  "private": true,
  "description": "Mini ERP de rastreabilidade de lotes de café (projeto de portfólio AWS)",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "prepare": "husky",
    "dev:api": "pnpm --filter @traceflow/api dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "stack:up": "docker compose --profile full up -d --build",
    "openapi": "pnpm --filter @traceflow/api openapi && pnpm --filter @traceflow/shared api:types",
    "openapi:check": "pnpm openapi && git diff --exit-code -- packages/shared/openapi.json packages/shared/src/api"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
