{
  "name": "@traceflow/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Tipos e constantes de domínio compartilhados entre API e web",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript openapi.json -o src/api/schema.ts && prettier --write src/api/schema.ts openapi.json"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "tsup": "^9.0.0"
  }
}
