              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DevUser"
                  }
                }
              }
            }
          }
        },
        "summary": "Lista os usuários ativos para a tela de login de desenvolvimento",
        "tags": ["dev (somente AUTH_MODE=mock)"]
      }
    },
    "/v1/dev/token": {
      "post": {
        "operationId": "DevAuthController_token",
        "parameters": [],
        "requestBody": {
          "required": true,
