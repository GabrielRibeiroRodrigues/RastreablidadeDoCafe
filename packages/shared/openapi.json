  "info": {
    "title": "TraceFlow API",
    "description": "Rastreabilidade de lotes de café",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "MeCompany": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Torrefação Serra Azul"
          }
        },
        "required": ["id", "name"]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "ana@serraazul.dev"
          },
          "name": {
            "type": "string",
            "example": "Ana Ribeiro"
          },
          "roles": {
            "type": "array",
            "example": ["admin"],
            "items": {
              "type": "string",
              "enum": ["admin", "operator", "auditor"]
            }
          },
          "company": {
            "$ref": "#/components/schemas/MeCompany"
          }
        },
        "required": ["id", "email", "name", "roles", "company"]
      },
      "DevUser": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@serraazul.dev"
          },
          "name": {
            "type": "string",
            "example": "Ana Ribeiro"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["admin", "operator", "auditor"]
            }
          },
          "companyName": {
            "type": "string",
            "example": "Torrefação Serra Azul"
          }
        },
        "required": ["email", "name", "roles", "companyName"]
      },
      "DevTokenRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@serraazul.dev"
          }
        },
        "required": ["email"]
      },
      "DevTokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "example": 3600
          }
        },
        "required": ["accessToken", "expiresIn"]
      },
      "CompanyResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Torrefação Serra Azul"
          },
          "taxId": {
            "type": "string",
            "description": "CNPJ (somente dígitos)",
            "example": "12345678000190"
          },
          "lotPrefix": {
            "type": "string",
            "description": "Prefixo dos códigos de lote",
            "example": "CAF"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["id", "name", "taxId", "lotPrefix", "createdAt"]
      },
      "UpdateCompanyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Torrefação Serra Azul"
          }
        },
        "required": ["name"]
      },
      "PageMeta": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "example": 1
          },
          "pageSize": {
            "type": "number",
            "example": 20
          },
          "total": {
            "type": "number",
            "example": 42
          },
          "totalPages": {
            "type": "number",
            "example": 3
          }
        },
        "required": ["page", "pageSize", "total", "totalPages"]
      },
      "ProductType": {
        "type": "string",
        "enum": ["GREEN", "ROASTED", "BLEND", "PACKAGING"]
      },
      "Unit": {
        "type": "string",
        "enum": ["KG", "BAG_60KG", "UNIT"]
      },
      "RoastLevel": {
        "type": "string",
        "enum": ["LIGHT", "MEDIUM_LIGHT", "MEDIUM", "MEDIUM_DARK", "DARK"]
      },
      "ProductResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string",
            "example": "VRD-BOURBON-AM"
          },
          "name": {
            "type": "string",
            "example": "Café verde Bourbon Amarelo"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProductType"
              }
            ]
          },
          "unit": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Unit"
              }
            ]
          },
          "defaultRoastLevel": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/RoastLevel"
              }
            ]
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "sku",
          "name",
          "type",
          "unit",
          "defaultRoastLevel",
          "description",
          "isActive",
          "createdAt",
          "updatedAt"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "Código interno, único na empresa",
            "example": "VRD-BOURBON-AM"
          },
          "name": {
            "type": "string",
            "example": "Café verde Bourbon Amarelo"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProductType"
              }
            ]
          },
          "unit": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Unit"
              }
            ]
          },
          "defaultRoastLevel": {
            "nullable": true,
            "description": "Só para torrados e blends",
            "allOf": [
              {
                "$ref": "#/components/schemas/RoastLevel"
              }
            ]
          },
          "description": {
            "type": "object",
            "example": "Notas de caramelo",
            "nullable": true
          }
        },
        "required": ["sku", "name", "type", "unit"]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "Código interno, único na empresa",
            "example": "VRD-BOURBON-AM"
          },
          "name": {
            "type": "string",
            "example": "Café verde Bourbon Amarelo"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProductType"
              }
            ]
          },
          "unit": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Unit"
              }
            ]
          },
          "defaultRoastLevel": {
            "nullable": true,
            "description": "Só para torrados e blends",
            "allOf": [
              {
                "$ref": "#/components/schemas/RoastLevel"
              }
            ]
          },
          "description": {
            "type": "object",
            "example": "Notas de caramelo",
            "nullable": true
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "uptime": {
            "type": "number",
            "description": "Segundos desde que o processo iniciou",
            "example": 42.1
          }
        },
        "required": ["status", "uptime"]
      },
      "ReadinessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "database": {
            "type": "string",
            "example": "up"
          }
        },
        "required": ["status", "database"]
      }
    }
  }
}
