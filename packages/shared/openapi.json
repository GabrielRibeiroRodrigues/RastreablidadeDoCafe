          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevTokenResponse"
                }
              }
            }
          }
        },
        "summary": "Emite um access token no formato do Cognito para o usuário",
        "tags": ["dev (somente AUTH_MODE=mock)"]
      }
    },
    "/v1/dev/.well-known/jwks.json": {
      "get": {
        "operationId": "DevAuthController_jwks",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Chave pública do emissor simulado (formato JWKS, como o Cognito)",
        "tags": ["dev (somente AUTH_MODE=mock)"]
      }
    },
