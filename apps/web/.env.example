# Copie para `.env.local` e ajuste. Apenas variáveis com prefixo VITE_ chegam ao navegador:
# nunca coloque segredos aqui.

# URL base da API NestJS (sem barra no final).
VITE_API_URL=http://localhost:3000

# Estratégia de login: `mock` (usuários de desenvolvimento servidos pela API) ou `cognito`.
VITE_AUTH_MODE=mock

# --- Obrigatórias apenas com VITE_AUTH_MODE=cognito ---

# Emissor OIDC do User Pool: https://cognito-idp.<região>.amazonaws.com/<user-pool-id>
VITE_COGNITO_AUTHORITY=
# App client público (sem secret), com Authorization Code + PKCE habilitado.
VITE_COGNITO_CLIENT_ID=
# Callback cadastrada no app client (rota /auth/callback do front).
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
# Sign-out URL cadastrada no app client (para onde o Cognito volta após o logout).
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/login
# Domínio do Hosted UI/Managed Login: https://<prefixo>.auth.<região>.amazoncognito.com
VITE_COGNITO_DOMAIN=
