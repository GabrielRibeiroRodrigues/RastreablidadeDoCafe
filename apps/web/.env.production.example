# Build de produção (AWS). No deploy pelo GitHub Actions estas variáveis são preenchidas a partir
# dos outputs do Terraform (.github/workflows/deploy.yml). Para um build manual:
#   cd infra/terraform/envs/prod && terraform output
# e copie este arquivo para `apps/web/.env.production.local`. Nada aqui é segredo: tudo vai
# para o navegador.

# Output `api_url` (sem barra no final).
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

VITE_AUTH_MODE=cognito

# Output `cognito_authority`: https://cognito-idp.<região>.amazonaws.com/<user-pool-id>
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
# Output `cognito_client_id`.
VITE_COGNITO_CLIENT_ID=
# Output `web_url` + /auth/callback e /login (cadastradas no app client pelo Terraform).
VITE_COGNITO_REDIRECT_URI=https://dxxxxxxxxxxxxx.cloudfront.net/auth/callback
VITE_COGNITO_LOGOUT_URI=https://dxxxxxxxxxxxxx.cloudfront.net/login
# Output `cognito_domain`: https://<prefixo>.auth.<região>.amazoncognito.com
VITE_COGNITO_DOMAIN=https://traceflow-prod-123456789012.auth.us-east-1.amazoncognito.com
