// Schema do TraceFlow. Convenções:
// - Modelos/campos em inglês e camelCase; tabelas/colunas em snake_case (@@map/@map).
// - Toda tabela de negócio tem company_id, e únicos/índices começam por ele (ADR 0004).
// - IDs UUID v7 (ordenáveis por tempo).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATOR
  AUDITOR

  @@map("role")
}

enum ProductType {
  GREEN // café verde
  ROASTED // café torrado
  BLEND
  PACKAGING // embalagem

  @@map("product_type")
}

enum Unit {
  KG
  BAG_60KG // saca de 60 kg
  UNIT

  @@map("unit")
}

enum RoastLevel {
  LIGHT
  MEDIUM_LIGHT
  MEDIUM
  MEDIUM_DARK
  DARK

  @@map("roast_level")
}

enum SupplierType {
  PRODUCER // produtor rural (pessoa física)
  FARM // fazenda
  COOPERATIVE
  TRADER

  @@map("supplier_type")
}

enum LocationType {
  WAREHOUSE // armazém
  SILO
  ROASTERY // torrefação
  QUARANTINE // área de quarentena
  SHIPPING // expedição

  @@map("location_type")
}

model Company {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  /// CNPJ (somente dígitos)
  taxId     String   @unique @map("tax_id") @db.VarChar(14)
  /// Prefixo dos códigos de lote, ex.: CAF -> CAF-2026-000123
  lotPrefix String   @map("lot_prefix") @db.VarChar(5)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users            User[]
  products         Product[]
  suppliers        Supplier[]
  customers        Customer[]
  locations        Location[]
  lots             Lot[]
  movements        StockMovement[]
  lotSequences     LotSequence[]
  productionOrders ProductionOrder[]
  lotOrigins       LotOrigin[]
  shipments        Shipment[]
  shipmentItems    ShipmentItem[]
  sequences        DocumentSequence[]
  attachments      Attachment[]

  @@map("companies")
}

/// Usuário pertence a uma única empresa. A autorização usa os grupos do token (Cognito);
/// `role` é o perfil provisionado, usado pelo emissor simulado e para sincronizar grupos.
model User {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  /// `sub` do Cognito (ou do emissor simulado)
  cognitoSub String   @unique @map("cognito_sub")
  email      String   @unique
  name       String
  role       Role
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  movements        StockMovement[]
  attachments      Attachment[]
  productionOrders ProductionOrder[]
  shipments        Shipment[]

  /// Alvo de FKs compostas: garante no banco que referências são da mesma empresa.
  @@unique([companyId, id])
  @@index([companyId])
  @@map("users")
}

model Product {
  id                String      @id @default(uuid(7)) @db.Uuid
  companyId         String      @map("company_id") @db.Uuid
  sku               String      @db.VarChar(40)
  name              String
  type              ProductType
  unit              Unit
  /// Grau de torra padrão (apenas torrados/blends); o grau real fica no lote.
  defaultRoastLevel RoastLevel? @map("default_roast_level")
  description       String?
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lots    Lot[]

  @@unique([companyId, id])
  @@unique([companyId, sku])
  @@index([companyId, name])
  @@map("products")
}

model Supplier {
  id             String       @id @default(uuid(7)) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  name           String
  type           SupplierType
  /// CPF ou CNPJ (somente dígitos)
  document       String?      @db.VarChar(14)
  farmName       String?      @map("farm_name")
  /// Região produtora, ex.: Sul de Minas, Cerrado Mineiro, Mantiqueira de Minas
  region         String?
  city           String?
  /// UF
  state          String?      @db.Char(2)
  altitudeMeters Int?         @map("altitude_meters")
  /// Variedades cultivadas, ex.: Bourbon Amarelo, Catuaí Vermelho
  varieties      String[]     @default([])
  email          String?
  phone          String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lots    Lot[]

  @@unique([companyId, document])
  @@index([companyId, name])
  @@map("suppliers")
}

model Customer {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  /// CPF ou CNPJ (somente dígitos)
  document  String?  @db.VarChar(14)
  email     String?
  phone     String?
  city      String?
  state     String?  @db.Char(2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  shipments Shipment[]

  @@unique([companyId, document])
  @@unique([companyId, id])
  @@index([companyId, name])
  @@map("customers")
}

model Location {
  id          String       @id @default(uuid(7)) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  code        String       @db.VarChar(20)
  name        String
  type        LocationType
  description String?
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  movementsFrom StockMovement[] @relation("MovementFrom")
  movementsTo   StockMovement[] @relation("MovementTo")
  shipmentItems ShipmentItem[]

  @@unique([companyId, code])
  @@map("locations")
}

// ───────────────────────────── Semana 2: lotes e estoque ─────────────────────────────

enum LotStatus {
  AVAILABLE // disponível
  QUARANTINE // em quarentena: não sai nem é transferido
  BLOCKED // bloqueado (ex.: recall): não sai nem é transferido
  CONSUMED // saldo zerado (automático)

  @@map("lot_status")
}

/// Tipos de movimentação. Todas são linhas imutáveis do razão de estoque (ADR 0007).
enum MovementType {
  RECEIPT // entrada (recebimento de fornecedor): só destino
  ISSUE // saída (venda/expedição): só origem
  TRANSFER // transferência entre locais: origem e destino
  ADJUSTMENT // ajuste de inventário: origem (perda) ou destino (sobra)
  CONSUMPTION // consumo em produção: só origem
  PRODUCTION // produção de lote novo: só destino
  REVERSAL // estorno: origem/destino invertidos de uma movimentação anterior

  @@map("movement_type")
}

enum AttachmentStatus {
  PENDING // URL de upload emitida, arquivo ainda não confirmado
  UPLOADED

  @@map("attachment_status")
}

model Lot {
  id              String      @id @default(uuid(7)) @db.Uuid
  companyId       String      @map("company_id") @db.Uuid
  /// Ex.: CAF-2026-000123 (prefixo da empresa, ano, sequência anual)
  code            String      @db.VarChar(30)
  productId       String      @map("product_id") @db.Uuid
  supplierId      String?     @map("supplier_id") @db.Uuid
  /// Quantidade recebida/produzida originalmente (o saldo vem do razão)
  initialQuantity Decimal     @map("initial_quantity") @db.Decimal(14, 3)
  unit            Unit
  status          LotStatus   @default(AVAILABLE)
  expiresAt       DateTime?   @map("expires_at") @db.Date
  receivedAt      DateTime    @default(now()) @map("received_at") @db.Timestamptz(3)
  /// Safra, ex.: "2025/26"
  harvest         String?     @db.VarChar(9)
  variety         String?     @db.VarChar(60)
  altitudeMeters  Int?        @map("altitude_meters")
  /// Peneira (8–20)
  screenSize      Int?        @map("screen_size")
  moisturePercent Decimal?    @map("moisture_percent") @db.Decimal(4, 2)
  roastLevel      RoastLevel? @map("roast_level")
  /// Pontuação SCA (0–100)
  cuppingScore    Decimal?    @map("cupping_score") @db.Decimal(5, 2)
  notes           String?
  /// Token aleatório do QR code da página pública (não expõe o id nem permite enumerar lotes).
  publicToken     String?     @unique @map("public_token") @db.VarChar(40)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// FK composta: o produto precisa ser da mesma empresa.
  product       Product          @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Restrict)
  /// FK simples (opcional): a mesma empresa é validada no serviço.
  supplier      Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  movements     StockMovement[]
  attachments   Attachment[]
  /// Genealogia: de quais lotes este veio, e quais lotes vieram dele.
  origins       LotOrigin[]      @relation("ChildLot")
  derived       LotOrigin[]      @relation("ParentLot")
  producedBy    ProductionOrder?
  shipmentItems ShipmentItem[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, productId])
  @@index([companyId, expiresAt])
  @@map("lots")
}

/// Sequência anual de códigos de lote por empresa (incremento atômico via ON CONFLICT).
model LotSequence {
  companyId String @map("company_id") @db.Uuid
  year      Int
  lastValue Int    @map("last_value")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([companyId, year])
  @@map("lot_sequences")
}

/// Razão de estoque: linhas IMUTÁVEIS (trigger no banco bloqueia UPDATE/DELETE).
/// Saldo de um lote num local = entradas (to) − saídas (from).
model StockMovement {
  id             String       @id @default(uuid(7)) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  type           MovementType
  lotId          String       @map("lot_id") @db.Uuid
  fromLocationId String?      @map("from_location_id") @db.Uuid
  toLocationId   String?      @map("to_location_id") @db.Uuid
  /// Sempre positiva; a direção vem de origem/destino.
  quantity       Decimal      @db.Decimal(14, 3)
  userId         String       @map("user_id") @db.Uuid
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Documento de referência: NF, ordem de produção, pedido...
  documentRef    String?      @map("document_ref") @db.VarChar(60)
  reason         String?
  /// Estorno: aponta a movimentação estornada (cada uma só pode ser estornada uma vez).
  reversalOfId   String?      @unique @map("reversal_of_id") @db.Uuid
  /// Chave de idempotência enviada pelo cliente (header Idempotency-Key).
  idempotencyKey String?      @map("idempotency_key") @db.VarChar(100)
  /// Hash do corpo da requisição original, para detectar reuso da chave com outro conteúdo.
  requestHash    String?      @map("request_hash") @db.VarChar(64)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// FKs compostas: lote e usuário precisam ser da mesma empresa.
  lot          Lot            @relation(fields: [companyId, lotId], references: [companyId, id], onDelete: Restrict)
  user         User           @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Restrict)
  fromLocation Location?      @relation("MovementFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   Location?      @relation("MovementTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  reversalOf   StockMovement? @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy   StockMovement? @relation("Reversal")
  shipmentItem ShipmentItem?

  @@unique([companyId, idempotencyKey])
  @@index([companyId, lotId])
  @@index([companyId, occurredAt])
  @@map("stock_movements")
}

model Attachment {
  id           String           @id @default(uuid(7)) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  lotId        String           @map("lot_id") @db.Uuid
  fileName     String           @map("file_name") @db.VarChar(200)
  contentType  String           @map("content_type") @db.VarChar(100)
  sizeBytes    Int              @map("size_bytes")
  /// Chave no bucket: {companyId}/lots/{lotId}/{uuid}
  storageKey   String           @unique @map("storage_key")
  status       AttachmentStatus @default(PENDING)
  uploadedById String           @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  uploadedAt   DateTime?        @map("uploaded_at") @db.Timestamptz(3)

  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lot        Lot     @relation(fields: [companyId, lotId], references: [companyId, id], onDelete: Restrict)
  uploadedBy User    @relation(fields: [companyId, uploadedById], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, lotId])
  @@map("attachments")
}

// ─────────────────────── Semana 3: produção, genealogia e expedição ───────────────────────

/// Etapas da cadeia do café após o recebimento (a colheita é o próprio lote recebido da fazenda).
enum ProductionStage {
  PROCESSING // beneficiamento (café em coco/pergaminho → café verde)
  ROASTING // torra
  BLENDING // blend de cafés torrados
  PACKAGING // embalagem

  @@map("production_stage")
}

/// Sequências de documentos por empresa e ano (OP-2026-000001, EXP-2026-000001).
model DocumentSequence {
  companyId String @map("company_id") @db.Uuid
  /// Ex.: "production_order", "shipment"
  kind      String @db.VarChar(40)
  year      Int
  lastValue Int    @map("last_value")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([companyId, kind, year])
  @@map("document_sequences")
}

/// Ordem de produção executada: consome lotes de insumo e gera um lote novo, numa transação.
model ProductionOrder {
  id             String          @id @default(uuid(7)) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  /// Ex.: OP-2026-000001
  number         String          @db.VarChar(30)
  stage          ProductionStage
  outputLotId    String          @map("output_lot_id") @db.Uuid
  /// Massa dos insumos em kg (sacas convertidas; embalagens/unidades não entram).
  inputMassKg    Decimal         @map("input_mass_kg") @db.Decimal(14, 3)
  /// Massa produzida em kg (null se a saída for em unidades).
  outputMassKg   Decimal?        @map("output_mass_kg") @db.Decimal(14, 3)
  /// Rendimento = saída / entrada × 100 (ex.: torra ≈ 82%).
  yieldPercent   Decimal?        @map("yield_percent") @db.Decimal(6, 2)
  /// Perda = entrada − saída, em kg.
  lossKg         Decimal?        @map("loss_kg") @db.Decimal(14, 3)
  notes          String?
  userId         String          @map("user_id") @db.Uuid
  performedAt    DateTime        @default(now()) @map("performed_at") @db.Timestamptz(3)
  idempotencyKey String?         @map("idempotency_key") @db.VarChar(100)
  requestHash    String?         @map("request_hash") @db.VarChar(64)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  outputLot Lot         @relation(fields: [companyId, outputLotId], references: [companyId, id], onDelete: Restrict)
  user      User        @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Restrict)
  origins   LotOrigin[]

  @@unique([companyId, id])
  @@unique([companyId, outputLotId])
  @@unique([companyId, number])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, performedAt])
  @@map("production_orders")
}

/// Genealogia (aresta do grafo): o lote filho foi feito consumindo `quantity` do lote pai.
/// Só inclusão — base das consultas recursivas de rastreabilidade (WITH RECURSIVE).
model LotOrigin {
  id                String   @id @default(uuid(7)) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  childLotId        String   @map("child_lot_id") @db.Uuid
  parentLotId       String   @map("parent_lot_id") @db.Uuid
  productionOrderId String   @map("production_order_id") @db.Uuid
  /// Quantidade consumida do pai, na unidade do pai.
  quantity          Decimal  @db.Decimal(14, 3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  child           Lot             @relation("ChildLot", fields: [companyId, childLotId], references: [companyId, id], onDelete: Restrict)
  parent          Lot             @relation("ParentLot", fields: [companyId, parentLotId], references: [companyId, id], onDelete: Restrict)
  productionOrder ProductionOrder @relation(fields: [companyId, productionOrderId], references: [companyId, id], onDelete: Restrict)

  @@unique([productionOrderId, parentLotId])
  @@index([companyId, childLotId])
  @@index([companyId, parentLotId])
  @@map("lot_origins")
}

/// Expedição para um cliente: cada item é uma saída (ISSUE) do razão.
model Shipment {
  id             String   @id @default(uuid(7)) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  /// Ex.: EXP-2026-000001
  number         String   @db.VarChar(30)
  customerId     String   @map("customer_id") @db.Uuid
  /// Pedido do cliente / NF de saída
  orderRef       String?  @map("order_ref") @db.VarChar(60)
  shippedAt      DateTime @default(now()) @map("shipped_at") @db.Timestamptz(3)
  notes          String?
  userId         String   @map("user_id") @db.Uuid
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(100)
  requestHash    String?  @map("request_hash") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer Customer       @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict)
  user     User           @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Restrict)
  items    ShipmentItem[]

  @@unique([companyId, id])
  @@unique([companyId, number])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, customerId])
  @@index([companyId, shippedAt])
  @@map("shipments")
}

model ShipmentItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  shipmentId String   @map("shipment_id") @db.Uuid
  lotId      String   @map("lot_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  quantity   Decimal  @db.Decimal(14, 3)
  /// Saída (ISSUE) gerada no razão para este item.
  movementId String   @unique @map("movement_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  shipment Shipment      @relation(fields: [companyId, shipmentId], references: [companyId, id], onDelete: Restrict)
  lot      Lot           @relation(fields: [companyId, lotId], references: [companyId, id], onDelete: Restrict)
  location Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  movement StockMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@index([companyId, shipmentId])
  @@index([companyId, lotId])
  @@map("shipment_items")
}
