// Schema do TraceFlow. Convenções:
// - Modelos/campos em inglês e camelCase; tabelas/colunas em snake_case (@@map/@map).
// - Toda tabela de negócio tem company_id, e únicos/índices começam por ele (ADR 0004).
// - IDs UUID v7 (ordenáveis por tempo).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATOR
  AUDITOR

  @@map("role")
}

enum ProductType {
  GREEN // café verde
  ROASTED // café torrado
  BLEND
  PACKAGING // embalagem

  @@map("product_type")
}

enum Unit {
  KG
  BAG_60KG // saca de 60 kg
  UNIT

  @@map("unit")
}

enum RoastLevel {
  LIGHT
  MEDIUM_LIGHT
  MEDIUM
  MEDIUM_DARK
  DARK

  @@map("roast_level")
}

enum SupplierType {
  PRODUCER // produtor rural (pessoa física)
  FARM // fazenda
  COOPERATIVE
  TRADER

  @@map("supplier_type")
}

enum LocationType {
  WAREHOUSE // armazém
  SILO
  ROASTERY // torrefação
  QUARANTINE // área de quarentena
  SHIPPING // expedição

  @@map("location_type")
}

model Company {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String
  /// CNPJ (somente dígitos)
  taxId      String   @unique @map("tax_id") @db.VarChar(14)
  /// Prefixo dos códigos de lote, ex.: CAF -> CAF-2026-000123
  lotPrefix  String   @map("lot_prefix") @db.VarChar(5)
  /// Identidade na página pública e na etiqueta: cor da marca (#RRGGBB), frase curta e site.
  brandColor String?  @map("brand_color") @db.VarChar(7)
  tagline    String?  @db.VarChar(140)
  website    String?  @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users            User[]
  products         Product[]
  suppliers        Supplier[]
  customers        Customer[]
  locations        Location[]
  lots             Lot[]
  movements        StockMovement[]
  lotSequences     LotSequence[]
  productionOrders ProductionOrder[]
  lotOrigins       LotOrigin[]
  shipments        Shipment[]
  shipmentItems    ShipmentItem[]
  sequences        DocumentSequence[]
  attachments      Attachment[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  nonConformities  NonConformity[]
  recalls          Recall[]
  recallSteps      RecallStep[]
  recallLots       RecallLot[]
  recallCustomers  RecallCustomer[]

  @@map("companies")
}

/// Usuário pertence a uma única empresa. A autorização usa os grupos do token (Cognito);
/// `role` é o perfil provisionado, usado pelo emissor simulado e para sincronizar grupos.
model User {
  id                 String   @id @default(uuid(7)) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  /// `sub` do Cognito (ou do emissor simulado)
  cognitoSub         String   @unique @map("cognito_sub")
  email              String   @unique
  name               String
  role               Role
  isActive           Boolean  @default(true) @map("is_active")
  /// Categorias de aviso que o usuário silenciou na central (ex.: expiry, quality).
  mutedNotifications String[] @default([]) @map("muted_notifications")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company            Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  notifications      Notification[]
  movements          StockMovement[]
  attachments        Attachment[]
  productionOrders   ProductionOrder[] @relation("ProductionOrderUser")
  cancelledOrders    ProductionOrder[] @relation("ProductionOrderCancelledBy")
  shipments          Shipment[]        @relation("ShipmentUser")
  cancelledShipments Shipment[]        @relation("ShipmentCancelledBy")
  auditLogs          AuditLog[]
  openedNcs          NonConformity[]   @relation("NcOpenedBy")
  resolvedNcs        NonConformity[]   @relation("NcResolvedBy")
  createdRecalls     Recall[]          @relation("RecallCreatedBy")
  closedRecalls      Recall[]          @relation("RecallClosedBy")

  /// Alvo de FKs compostas: garante no banco que referências são da mesma empresa.
  @@unique([companyId, id])
  @@index([companyId])
  @@map("users")
}

model Product {
  id                String      @id @default(uuid(7)) @db.Uuid
  companyId         String      @map("company_id") @db.Uuid
  sku               String      @db.VarChar(40)
  name              String
  type              ProductType
  unit              Unit
  /// Grau de torra padrão (apenas torrados/blends); o grau real fica no lote.
  defaultRoastLevel RoastLevel? @map("default_roast_level")
  description       String?
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lots    Lot[]

  @@unique([companyId, id])
  @@unique([companyId, sku])
  @@index([companyId, name])
  @@map("products")
}

model Supplier {
  id             String       @id @default(uuid(7)) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  name           String
  type           SupplierType
  /// CPF ou CNPJ (somente dígitos)
  document       String?      @db.VarChar(14)
  farmName       String?      @map("farm_name")
  /// Região produtora, ex.: Sul de Minas, Cerrado Mineiro, Mantiqueira de Minas
  region         String?
  city           String?
  /// UF
  state          String?      @db.Char(2)
  altitudeMeters Int?         @map("altitude_meters")
  /// Variedades cultivadas, ex.: Bourbon Amarelo, Catuaí Vermelho
  varieties      String[]     @default([])
  email          String?
  phone          String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lots    Lot[]

  @@unique([companyId, document])
  @@index([companyId, name])
  @@map("suppliers")
}

model Customer {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  /// CPF ou CNPJ (somente dígitos)
  document  String?  @db.VarChar(14)
  email     String?
  phone     String?
  city      String?
  state     String?  @db.Char(2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  shipments       Shipment[]
  recallCustomers RecallCustomer[]

  @@unique([companyId, document])
  @@unique([companyId, id])
  @@index([companyId, name])
  @@map("customers")
}

model Location {
  id          String       @id @default(uuid(7)) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  code        String       @db.VarChar(20)
  name        String
  type        LocationType
  description String?
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  movementsFrom StockMovement[] @relation("MovementFrom")
  movementsTo   StockMovement[] @relation("MovementTo")
  shipmentItems ShipmentItem[]

  @@unique([companyId, code])
  @@map("locations")
}

// ───────────────────────────── Semana 2: lotes e estoque ─────────────────────────────

enum LotStatus {
  AVAILABLE // disponível
  QUARANTINE // em quarentena: não sai nem é transferido
  BLOCKED // bloqueado (ex.: recall): não sai nem é transferido
  CONSUMED // saldo zerado (automático)

  @@map("lot_status")
}

/// Tipos de movimentação. Todas são linhas imutáveis do razão de estoque (ADR 0007).
enum MovementType {
  RECEIPT // entrada (recebimento de fornecedor): só destino
  ISSUE // saída (venda/expedição): só origem
  TRANSFER // transferência entre locais: origem e destino
  ADJUSTMENT // ajuste de inventário: origem (perda) ou destino (sobra)
  CONSUMPTION // consumo em produção: só origem
  PRODUCTION // produção de lote novo: só destino
  REVERSAL // estorno: origem/destino invertidos de uma movimentação anterior

  @@map("movement_type")
}

enum AttachmentStatus {
  PENDING // URL de upload emitida, arquivo ainda não confirmado
  UPLOADED

  @@map("attachment_status")
}

model Lot {
  id              String      @id @default(uuid(7)) @db.Uuid
  companyId       String      @map("company_id") @db.Uuid
  /// Ex.: CAF-2026-000123 (prefixo da empresa, ano, sequência anual)
  code            String      @db.VarChar(30)
  productId       String      @map("product_id") @db.Uuid
  supplierId      String?     @map("supplier_id") @db.Uuid
  /// Quantidade recebida/produzida originalmente (o saldo vem do razão)
  initialQuantity Decimal     @map("initial_quantity") @db.Decimal(14, 3)
  unit            Unit
  status          LotStatus   @default(AVAILABLE)
  expiresAt       DateTime?   @map("expires_at") @db.Date
  receivedAt      DateTime    @default(now()) @map("received_at") @db.Timestamptz(3)
  /// Safra, ex.: "2025/26"
  harvest         String?     @db.VarChar(9)
  variety         String?     @db.VarChar(60)
  altitudeMeters  Int?        @map("altitude_meters")
  /// Peneira (8–20)
  screenSize      Int?        @map("screen_size")
  moisturePercent Decimal?    @map("moisture_percent") @db.Decimal(4, 2)
  roastLevel      RoastLevel? @map("roast_level")
  /// Pontuação SCA (0–100)
  cuppingScore    Decimal?    @map("cupping_score") @db.Decimal(5, 2)
  notes           String?
  /// Token aleatório do QR code da página pública (não expõe o id nem permite enumerar lotes).
  publicToken     String?     @unique @map("public_token") @db.VarChar(40)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// FK composta: o produto precisa ser da mesma empresa.
  product         Product          @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Restrict)
  /// FK simples (opcional): a mesma empresa é validada no serviço.
  supplier        Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  movements       StockMovement[]
  attachments     Attachment[]
  /// Genealogia: de quais lotes este veio, e quais lotes vieram dele.
  origins         LotOrigin[]      @relation("ChildLot")
  derived         LotOrigin[]      @relation("ParentLot")
  producedBy      ProductionOrder?
  shipmentItems   ShipmentItem[]
  nonConformities NonConformity[]
  recallsAsOrigin Recall[]
  recallLots      RecallLot[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, productId])
  @@index([companyId, expiresAt])
  /// Ordem padrão da tela Lotes (mais recentes primeiro).
  @@index([companyId, receivedAt])
  @@map("lots")
}

/// Sequência anual de códigos de lote por empresa (incremento atômico via ON CONFLICT).
model LotSequence {
  companyId String @map("company_id") @db.Uuid
  year      Int
  lastValue Int    @map("last_value")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([companyId, year])
  @@map("lot_sequences")
}

/// Razão de estoque: linhas IMUTÁVEIS (trigger no banco bloqueia UPDATE/DELETE).
/// Saldo de um lote num local = entradas (to) − saídas (from).
model StockMovement {
  id             String       @id @default(uuid(7)) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  type           MovementType
  lotId          String       @map("lot_id") @db.Uuid
  fromLocationId String?      @map("from_location_id") @db.Uuid
  toLocationId   String?      @map("to_location_id") @db.Uuid
  /// Sempre positiva; a direção vem de origem/destino.
  quantity       Decimal      @db.Decimal(14, 3)
  userId         String       @map("user_id") @db.Uuid
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Documento de referência: NF, ordem de produção, pedido...
  documentRef    String?      @map("document_ref") @db.VarChar(60)
  reason         String?
  /// Estorno: aponta a movimentação estornada (cada uma só pode ser estornada uma vez).
  reversalOfId   String?      @unique @map("reversal_of_id") @db.Uuid
  /// Chave de idempotência enviada pelo cliente (header Idempotency-Key).
  idempotencyKey String?      @map("idempotency_key") @db.VarChar(100)
  /// Hash do corpo da requisição original, para detectar reuso da chave com outro conteúdo.
  requestHash    String?      @map("request_hash") @db.VarChar(64)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// FKs compostas: lote e usuário precisam ser da mesma empresa.
  lot          Lot            @relation(fields: [companyId, lotId], references: [companyId, id], onDelete: Restrict)
  user         User           @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Restrict)
  fromLocation Location?      @relation("MovementFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   Location?      @relation("MovementTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  reversalOf   StockMovement? @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy   StockMovement? @relation("Reversal")
  shipmentItem ShipmentItem?

  @@unique([companyId, idempotencyKey])
  @@index([companyId, lotId])
  @@index([companyId, occurredAt])
  @@map("stock_movements")
}

model Attachment {
  id           String           @id @default(uuid(7)) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  lotId        String           @map("lot_id") @db.Uuid
  fileName     String           @map("file_name") @db.VarChar(200)
  contentType  String           @map("content_type") @db.VarChar(100)
  sizeBytes    Int              @map("size_bytes")
  /// Chave no bucket: {companyId}/lots/{lotId}/{uuid}
  storageKey   String           @unique @map("storage_key")
  status       AttachmentStatus @default(PENDING)
  uploadedById String           @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  uploadedAt   DateTime?        @map("uploaded_at") @db.Timestamptz(3)

  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lot        Lot     @relation(fields: [companyId, lotId], references: [companyId, id], onDelete: Restrict)
  uploadedBy User    @relation(fields: [companyId, uploadedById], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, lotId])
  @@map("attachments")
}

// ─────────────────────── Semana 3: produção, genealogia e expedição ───────────────────────

/// Etapas da cadeia do café após o recebimento (a colheita é o próprio lote recebido da fazenda).
enum ProductionStage {
  PROCESSING // beneficiamento (café em coco/pergaminho → café verde)
  ROASTING // torra
  BLENDING // blend de cafés torrados
  PACKAGING // embalagem

  @@map("production_stage")
}

/// Sequências de documentos por empresa e ano (OP-2026-000001, EXP-2026-000001).
model DocumentSequence {
  companyId String @map("company_id") @db.Uuid
  /// Ex.: "production_order", "shipment"
  kind      String @db.VarChar(40)
  year      Int
  lastValue Int    @map("last_value")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([companyId, kind, year])
  @@map("document_sequences")
}

/// Ordem de produção executada: consome lotes de insumo e gera um lote novo, numa transação.
model ProductionOrder {
  id             String          @id @default(uuid(7)) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  /// Ex.: OP-2026-000001
  number         String          @db.VarChar(30)
  stage          ProductionStage
  outputLotId    String          @map("output_lot_id") @db.Uuid
  /// Massa dos insumos em kg (sacas convertidas; embalagens/unidades não entram).
  inputMassKg    Decimal         @map("input_mass_kg") @db.Decimal(14, 3)
  /// Massa produzida em kg (null se a saída for em unidades).
  outputMassKg   Decimal?        @map("output_mass_kg") @db.Decimal(14, 3)
  /// Rendimento = saída / entrada × 100 (ex.: torra ≈ 82%).
  yieldPercent   Decimal?        @map("yield_percent") @db.Decimal(6, 2)
  /// Perda = entrada − saída, em kg.
  lossKg         Decimal?        @map("loss_kg") @db.Decimal(14, 3)
  notes          String?
  userId         String          @map("user_id") @db.Uuid
  performedAt    DateTime        @default(now()) @map("performed_at") @db.Timestamptz(3)
  idempotencyKey String?         @map("idempotency_key") @db.VarChar(100)
  requestHash    String?         @map("request_hash") @db.VarChar(64)
  /// Cancelamento: todas as movimentações da operação foram estornadas numa transação.
  cancelledAt    DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelReason   String?         @map("cancel_reason")
  cancelledById  String?         @map("cancelled_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  outputLot   Lot         @relation(fields: [companyId, outputLotId], references: [companyId, id], onDelete: Restrict)
  user        User        @relation("ProductionOrderUser", fields: [companyId, userId], references: [companyId, id], onDelete: Restrict)
  cancelledBy User?       @relation("ProductionOrderCancelledBy", fields: [companyId, cancelledById], references: [companyId, id], onDelete: Restrict)
  origins     LotOrigin[]

  @@unique([companyId, id])
  @@unique([companyId, outputLotId])
  @@unique([companyId, number])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, performedAt])
  @@map("production_orders")
}

/// Genealogia (aresta do grafo): o lote filho foi feito consumindo `quantity` do lote pai.
/// Só inclusão — base das consultas recursivas de rastreabilidade (WITH RECURSIVE).
model LotOrigin {
  id                String   @id @default(uuid(7)) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  childLotId        String   @map("child_lot_id") @db.Uuid
  parentLotId       String   @map("parent_lot_id") @db.Uuid
  productionOrderId String   @map("production_order_id") @db.Uuid
  /// Quantidade consumida do pai, na unidade do pai.
  quantity          Decimal  @db.Decimal(14, 3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  child           Lot             @relation("ChildLot", fields: [companyId, childLotId], references: [companyId, id], onDelete: Restrict)
  parent          Lot             @relation("ParentLot", fields: [companyId, parentLotId], references: [companyId, id], onDelete: Restrict)
  productionOrder ProductionOrder @relation(fields: [companyId, productionOrderId], references: [companyId, id], onDelete: Restrict)

  @@unique([productionOrderId, parentLotId])
  @@index([companyId, childLotId])
  @@index([companyId, parentLotId])
  @@map("lot_origins")
}

/// Expedição para um cliente: cada item é uma saída (ISSUE) do razão.
model Shipment {
  id             String    @id @default(uuid(7)) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  /// Ex.: EXP-2026-000001
  number         String    @db.VarChar(30)
  customerId     String    @map("customer_id") @db.Uuid
  /// Pedido do cliente / NF de saída
  orderRef       String?   @map("order_ref") @db.VarChar(60)
  shippedAt      DateTime  @default(now()) @map("shipped_at") @db.Timestamptz(3)
  notes          String?
  userId         String    @map("user_id") @db.Uuid
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(100)
  requestHash    String?   @map("request_hash") @db.VarChar(64)
  /// Cancelamento: todas as movimentações da operação foram estornadas numa transação.
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason   String?   @map("cancel_reason")
  cancelledById  String?   @map("cancelled_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer    Customer       @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict)
  user        User           @relation("ShipmentUser", fields: [companyId, userId], references: [companyId, id], onDelete: Restrict)
  cancelledBy User?          @relation("ShipmentCancelledBy", fields: [companyId, cancelledById], references: [companyId, id], onDelete: Restrict)
  items       ShipmentItem[]

  @@unique([companyId, id])
  @@unique([companyId, number])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, customerId])
  @@index([companyId, shippedAt])
  @@map("shipments")
}

model ShipmentItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  shipmentId String   @map("shipment_id") @db.Uuid
  lotId      String   @map("lot_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  quantity   Decimal  @db.Decimal(14, 3)
  /// Saída (ISSUE) gerada no razão para este item.
  movementId String   @unique @map("movement_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  shipment Shipment      @relation(fields: [companyId, shipmentId], references: [companyId, id], onDelete: Restrict)
  lot      Lot           @relation(fields: [companyId, lotId], references: [companyId, id], onDelete: Restrict)
  location Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  movement StockMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@index([companyId, shipmentId])
  @@index([companyId, lotId])
  @@map("shipment_items")
}

// ───────────────────── Semana 4: auditoria, não conformidade e recall ─────────────────────

/// Trilha de auditoria: quem fez o quê, quando e de onde. Só inclusão (trigger no banco).
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  /// Null em jobs agendados (sem usuário).
  userId     String?  @map("user_id") @db.Uuid
  /// Ex.: lot.status_changed, recall.created, http.post
  action     String   @db.VarChar(80)
  /// Ex.: lot, recall, non_conformity, movement
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  before     Json?
  after      Json?
  requestId  String?  @map("request_id") @db.VarChar(128)
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User?   @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([companyId, userId])
  @@index([companyId, action])
  @@map("audit_logs")
}

enum NonConformityType {
  MOISTURE // umidade fora do padrão
  DEFECTS // defeitos (grãos ardidos, quebrados, broca...)
  CONTAMINATION // contaminação (micotoxina, corpo estranho)
  PEST // pragas
  PACKAGING // embalagem danificada
  OTHER

  @@map("non_conformity_type")
}

enum NonConformityStatus {
  OPEN // aberta: lote em quarentena
  RELEASED // liberada: lote volta a ficar disponível
  DISCARDED // descartada: saldo baixado por ajuste e lote consumido

  @@map("non_conformity_status")
}

/// Não conformidade de qualidade sobre um lote (NC-2026-000001).
model NonConformity {
  id           String              @id @default(uuid(7)) @db.Uuid
  companyId    String              @map("company_id") @db.Uuid
  number       String              @db.VarChar(30)
  lotId        String              @map("lot_id") @db.Uuid
  type         NonConformityType
  description  String
  status       NonConformityStatus @default(OPEN)
  openedById   String              @map("opened_by_id") @db.Uuid
  openedAt     DateTime            @default(now()) @map("opened_at") @db.Timestamptz(3)
  resolution   String?
  resolvedById String?             @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?           @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lot        Lot     @relation(fields: [companyId, lotId], references: [companyId, id], onDelete: Restrict)
  openedBy   User    @relation("NcOpenedBy", fields: [companyId, openedById], references: [companyId, id], onDelete: Restrict)
  resolvedBy User?   @relation("NcResolvedBy", fields: [companyId, resolvedById], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, number])
  @@index([companyId, lotId, status])
  @@index([companyId, status, openedAt])
  @@map("non_conformities")
}

enum RecallSeverity {
  LOW
  MEDIUM
  HIGH

  @@map("recall_severity")
}

enum RecallStatus {
  OPEN // criado, workflow ainda não iniciado
  EXECUTING // etapas em execução
  COMPLETED // todas as etapas concluídas
  FAILED // uma etapa falhou (pode ser retomado)
  CLOSED // encerrado com notas (lotes continuam bloqueados)

  @@map("recall_status")
}

enum RecallStepName {
  BLOCK_LOTS
  REPORT
  NOTIFY

  @@map("recall_step_name")
}

enum RecallStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED

  @@map("recall_step_status")
}

/// Recall (RC-2026-000001) a partir de um lote de origem; executado por etapas idempotentes.
model Recall {
  id           String         @id @default(uuid(7)) @db.Uuid
  companyId    String         @map("company_id") @db.Uuid
  number       String         @db.VarChar(30)
  originLotId  String         @map("origin_lot_id") @db.Uuid
  reason       String
  severity     RecallSeverity
  status       RecallStatus   @default(OPEN)
  /// Chave do relatório PDF no bucket: {companyId}/recalls/{id}.pdf
  reportKey    String?        @map("report_key")
  /// Execução no Step Functions (quando orquestrado na AWS).
  executionArn String?        @map("execution_arn")
  lastError    String?        @map("last_error")
  createdById  String         @map("created_by_id") @db.Uuid
  startedAt    DateTime?      @map("started_at") @db.Timestamptz(3)
  completedAt  DateTime?      @map("completed_at") @db.Timestamptz(3)
  closedById   String?        @map("closed_by_id") @db.Uuid
  closedAt     DateTime?      @map("closed_at") @db.Timestamptz(3)
  closingNotes String?        @map("closing_notes")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  originLot Lot              @relation(fields: [companyId, originLotId], references: [companyId, id], onDelete: Restrict)
  createdBy User             @relation("RecallCreatedBy", fields: [companyId, createdById], references: [companyId, id], onDelete: Restrict)
  closedBy  User?            @relation("RecallClosedBy", fields: [companyId, closedById], references: [companyId, id], onDelete: Restrict)
  steps     RecallStep[]
  lots      RecallLot[]
  customers RecallCustomer[]

  @@unique([companyId, id])
  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
  @@index([companyId, originLotId])
  @@map("recalls")
}

/// Etapa do workflow do recall: estado persistido para retomar de onde parou.
model RecallStep {
  id         String           @id @default(uuid(7)) @db.Uuid
  companyId  String           @map("company_id") @db.Uuid
  recallId   String           @map("recall_id") @db.Uuid
  name       RecallStepName
  /// Ordem de execução (1, 2, 3).
  position   Int
  status     RecallStepStatus @default(PENDING)
  attempts   Int              @default(0)
  startedAt  DateTime?        @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime?        @map("finished_at") @db.Timestamptz(3)
  error      String?
  /// Resultado resumido da etapa (ex.: lotes bloqueados, chave do relatório).
  output     Json?
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  recall  Recall  @relation(fields: [companyId, recallId], references: [companyId, id], onDelete: Restrict)

  @@unique([recallId, name])
  @@index([companyId, recallId])
  @@map("recall_steps")
}

/// Lote afetado pelo recall (o de origem e todos os derivados).
model RecallLot {
  id             String     @id @default(uuid(7)) @db.Uuid
  companyId      String     @map("company_id") @db.Uuid
  recallId       String     @map("recall_id") @db.Uuid
  lotId          String     @map("lot_id") @db.Uuid
  /// Distância até o lote de origem (0 = ele mesmo).
  depth          Int
  /// Saldo no momento da criação do recall.
  balance        Decimal    @db.Decimal(14, 3)
  /// Status antes do bloqueio (preenchido pela etapa BLOCK_LOTS).
  previousStatus LotStatus? @map("previous_status")
  blockedAt      DateTime?  @map("blocked_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  recall  Recall  @relation(fields: [companyId, recallId], references: [companyId, id], onDelete: Restrict)
  lot     Lot     @relation(fields: [companyId, lotId], references: [companyId, id], onDelete: Restrict)

  @@unique([recallId, lotId])
  @@index([companyId, lotId])
  @@map("recall_lots")
}

/// Cliente a contatar no recall, com o resumo do que recebeu dos lotes afetados.
model RecallCustomer {
  id              String   @id @default(uuid(7)) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  recallId        String   @map("recall_id") @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  shipmentsCount  Int      @map("shipments_count")
  shipmentNumbers String[] @map("shipment_numbers")
  /// Quantidade expedida por unidade: [{ unit: "KG", quantity: "12.000" }]
  quantities      Json
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  recall   Recall   @relation(fields: [companyId, recallId], references: [companyId, id], onDelete: Restrict)
  customer Customer @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict)

  @@unique([recallId, customerId])
  @@map("recall_customers")
}

/// Contadores do rate limit (janela fixa) compartilhados entre instâncias da API (Lambda).
/// Não é dado de negócio nem de empresa: a chave é derivada do IP pelo ThrottlerGuard.
model RateLimit {
  key       String   @id @db.VarChar(200)
  hits      Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limits")
}

/// Aviso na central do app (um registro por destinatário). Os mesmos eventos também saem pelo SNS.
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Ex.: recall.executed, recall.failed, lots.expiring, non_conformity.opened
  event     String    @db.VarChar(60)
  title     String    @db.VarChar(200)
  body      String    @db.VarChar(2000)
  /// Rota do front para abrir o assunto (ex.: /recall/{id}).
  link      String?   @db.VarChar(300)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, userId, createdAt])
  @@index([companyId, userId, readAt])
  @@map("notifications")
}
