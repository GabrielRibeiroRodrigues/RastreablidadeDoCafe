# Copie para .env e ajuste. Nunca commite o .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://traceflow:traceflow@localhost:5432/traceflow
DATABASE_POOL_MAX=10

# Autenticação (ADR 0005). Local: mock. Produção: cognito + região/pool.
AUTH_MODE=mock
COGNITO_CLIENT_ID=traceflow-local
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# Anexos (docs/anexos.md). Local: MinIO do docker compose (`pnpm storage:up`).
# Sem S3_BUCKET a API sobe normalmente, mas as rotas de anexos respondem 503.
S3_BUCKET=traceflow-attachments
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
# Só com a API em contêiner (S3_ENDPOINT=http://minio:9000): endpoint visto pelo navegador.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Credenciais do MinIO local. Na AWS, deixe vazio: a role da Lambda fornece as credenciais.
S3_ACCESS_KEY_ID=traceflow
S3_SECRET_ACCESS_KEY=traceflow-secret
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_URL_TTL_SECONDS=300
