# Copie para .env e ajuste. Nunca commite o .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true
CORS_ORIGINS=http://localhost:5173
# Swagger UI em /docs. Padrão: true fora de produção, false em produção.
SWAGGER_ENABLED=true
# Segurança e produção (docs/seguranca.md).
# Proxies confiáveis na frente da API: 0 local; 1 atrás de API Gateway/ALB.
TRUST_PROXY=0
# Limite global por IP (requisições/minuto); /v1/health* fica de fora.
RATE_LIMIT_PER_MINUTE=300
# Contadores do rate limit: memory (por instância) ou postgres (compartilhado; use em produção).
RATE_LIMIT_STORE=memory
# Tempo máximo por requisição antes de responder 503 (abaixo dos 30 s do API Gateway).
REQUEST_TIMEOUT_MS=25000
DATABASE_URL=postgresql://traceflow:traceflow@localhost:5432/traceflow
DATABASE_POOL_MAX=10

# Autenticação (ADR 0005). Local: mock. Produção: cognito + região/pool.
AUTH_MODE=mock
COGNITO_CLIENT_ID=traceflow-local
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# Anexos (docs/anexos.md). Local: MinIO do docker compose (`pnpm storage:up`).
# Sem S3_BUCKET a API sobe normalmente, mas as rotas de anexos respondem 503.
S3_BUCKET=traceflow-attachments
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
# Só com a API em contêiner (S3_ENDPOINT=http://minio:9000): endpoint visto pelo navegador.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Credenciais do MinIO local. Na AWS, deixe vazio: a role da Lambda fornece as credenciais.
S3_ACCESS_KEY_ID=traceflow
S3_SECRET_ACCESS_KEY=traceflow-secret
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_URL_TTL_SECONDS=300

# Etiquetas e página pública de rastreio (docs/etiqueta-pagina-publica.md).
# Base do link gravado no QR code: {PUBLIC_WEB_URL}/rastreio/{token}.
PUBLIC_WEB_URL=http://localhost:5173

# Recall, qualidade e alertas (docs/recall-qualidade-auditoria.md).
# Sem SNS_TOPIC_ARN os avisos vão para o log; sem RECALL_STATE_MACHINE_ARN o workflow do
# recall roda no próprio processo da API (padrão local).
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:traceflow-alerts
# RECALL_STATE_MACHINE_ARN=arn:aws:states:us-east-1:123456789012:stateMachine:traceflow-recall
ALERT_EXPIRY_DAYS=30
# Retenção da auditoria (dias) antes de o job mensal arquivar no bucket e remover.
AUDIT_RETENTION_DAYS=1825
