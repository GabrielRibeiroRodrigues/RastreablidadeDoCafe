# Copie para .env e ajuste. Nunca commite o .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://traceflow:traceflow@localhost:5432/traceflow
DATABASE_POOL_MAX=10

# Autenticação (ADR 0005). Local: mock. Produção: cognito + região/pool.
AUTH_MODE=mock
COGNITO_CLIENT_ID=traceflow-local
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
